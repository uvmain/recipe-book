{
  "name": "recipebook",
  "version": "1.0.0",
  "description": "Self Hosted Recipe recipebook",
  "main": "index.js",
  "packageManager": "pnpm@11.1.2",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uvmain/recipe-book.git"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "setup": "go install github.com/golangci/golangci-lint/cmd/golangci-lint@latest && go install golang.org/x/vuln/cmd/govulncheck@latest && go mod download",
    "clean:build": "node utils/rmr.js recipebook frontend/dist",
    "clean:full": "node utils/rmr.js recipebook data frontend/dist frontend/node_modules node_modules",
    "dev:backend": "go run .",
    "dev:frontend": "pnpm --filter ./frontend dev",
    "dev": "node utils/concurrently.js",
    "build:backend": "cross-env CGO_ENABLED=0 go build -ldflags=\"-s -w\" -o recipebook && node utils/copy.js recipebook ./recipebook.exe",
    "build:frontend": "pnpm --filter ./frontend build",
    "build": "pnpm build:frontend && pnpm build:backend",
    "preview": "node utils/concurrently.js preview",
    "preview:go": "recipebook",
    "caddy": "caddy run --config Caddyfile",
    "caddy:preview": "caddy run --config Caddyfile.preview",
    "cspell": "cspell \"**/*.{go,ts,js,vue}\"",
    "audit": "pnpm audit && govulncheck ./...",
    "lint:backend": "golangci-lint run",
    "lint:frontend": "pnpm --filter ./frontend lint",
    "lint": "pnpm lint:frontend && pnpm lint:backend",
    "lint:fix": "pnpm --filter ./frontend lint:fix",
    "deps:update": "go get -u && go mod tidy && pnpm update -r --latest"
  },
  "devDependencies": {
    "caddy-baron": "^5.0.2",
    "cross-env": "^10.1.0",
    "cspell": "^10.4.1"
  }
}
